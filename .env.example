# Example environment for Lexi. Copy to .env and fill in what you use.
# Every write, scheduler and agent flag is off by default.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://lexi:lexi@localhost:5432/lexi
REDIS_URL=
GITHUB_TOKEN=
GITHUB_EVIDENCE_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_OWNER=your-org
GITHUB_REPO=your-issues-repo
BUGHUNT_LABEL=bug
GITHUB_API_BASE_URL=
CROSS_ORG_TRUSTED_OWNERS=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_DEFAULT_CHANNEL=lexi
# Model keys. Both optional; each side falls back to the other. The agent loop
# uses LITELLM_API_KEY (else OPENAI_API_KEY); the decision engine behind
# POST /process uses OPENAI_API_KEY (else LITELLM_API_KEY) with OPENAI_MODEL.
# With neither, the server boots but refuses Slack turns and answers 501.
OPENAI_API_KEY=
CLAUDE_MODEL=
OPENAI_MODEL=claude-sonnet-5-5
OPENAI_BASE_URL=
LITELLM_BASE_URL=
LITELLM_API_KEY=
LITELLM_CLAUDE_MODEL=claude-sonnet-5-5
# Personal data is masked out of everything sent to a model (emails, phone
# numbers, card numbers, IBANs, IP addresses). Set to false to turn it off.
MODEL_PII_MASKING=true
# Your own patterns to mask as [redacted]: regexes separated by || (or newlines).
# Example: MODEL_PII_EXTRA_PATTERNS=EMP-\d{6}||CUST-[A-Z0-9]{8}
MODEL_PII_EXTRA_PATTERNS=
OWNERSHIP_CONFIG_PATH=config/ownership.yaml
QUICK_FIX_OWNERS_CONFIG_PATH=config/quick-fix-owners.yaml
REPRODUCTION_TIMEOUT_MS=1800000
REPRODUCTION_MIN_RUNTIME_MS=2000
REPRODUCTION_MAX_RUNTIME_MS=8000
REPRODUCTION_DELAY_MS=
REPRODUCTION_WORK_MS=
REPRODUCTION_PROVIDER=mock
REPRODUCTION_SLACK_CHANNEL=
REPRODUCTION_BOT_USER_ID=
REPRODUCTION_REPRODUCED_KEYWORDS=reproduced,verified
REPRODUCTION_CANNOT_REPRODUCE_KEYWORDS=
REPRODUCTION_FAILED_KEYWORDS=error,failed
EVIDENCE_STORAGE_PATH=./data/evidence
DAILY_AUTOMATION_ENABLED=false
SCHEDULER_DAILY_AUTOMATION_CRON=0 6 * * *
SCHEDULER_BACKLOG_CLEANUP_CRON=0 2 * * 0
SCHEDULER_RETRY_QUEUE_CRON=*/15 * * * *
SCHEDULER_PENDING_CLOSURE_CRON=0 8 * * *
SCHEDULER_INTAKE_WATCHER_CRON=*/10 * * * *
INTAKE_WATCHER_ENABLED=false
INTAKE_CONVERSATION_ENABLED=false
SCHEDULER_ENABLED=false
METRICS_PREFIX=lexi_
POLICY_AUTO_CLOSE_MIN_CONFIDENCE=0.85
POLICY_AUTO_CLOSE_MIN_SCENARIO_FIT=0.75
GITHUB_ADLC_INTAKE_ENABLED=false
ADLC_INTAKE_WEBHOOK_TOKEN=
GOVERNED_WRITES_ENABLED=false
GOVERNED_DRY_RUN=false
PENDING_CLOSURE_ENABLED=false
DUPLICATE_SEMANTIC_ENABLED=false
DUPLICATE_LLM_ADJUDICATION_ENABLED=false
DUPLICATE_HUMAN_ADJUDICATION_ENABLED=false
DUPLICATE_CONSOLIDATION_ENABLED=false
DUPLICATE_ADJUDICATION_CHANNEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=v3-small-2024
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
CLOSED_ISSUE_SEMANTICS_ENABLED=false
INTAKE_API_TOKEN=
INTAKE_ALLOW_UNAUTHENTICATED=false
CONFIG_REVISION=
GOVERNANCE_CONFIG_DIR=examples/config
DIGEST_SLACK_CHANNEL=
DIGEST_GITHUB_ISSUE=0
SLACK_AGENT_ENABLED=false
SLACK_AGENT_MODEL=
SLACK_AGENT_HELP_CONTACT_USER_ID=
SLACK_CHANNEL_POST_ENABLED=false
SLACK_CHANNEL_POST_ALLOWLIST=
AGENT_BATCH_ENABLED=false
AGENT_PROACTIVE_NOTIFICATIONS_ENABLED=false
AGENT_OWNER_MENTIONS_ENABLED=false
AGENT_BATCH_MAX_ISSUES=50
AGENT_BATCH_CONCURRENCY=5
AGENT_NOTIFICATION_MIN_PRIORITY=P2
AGENT_NOTIFICATION_DEDUP_WINDOW_MS=300000
AGENT_OWNER_MENTION_MIN_CONFIDENCE=0.8
EVIDENCE_PIPELINE_ENABLED=false
EVIDENCE_PIPELINE_LLM_ENABLED=false
EVIDENCE_PIPELINE_ENGINEERING_INVESTIGATION_ENABLED=false
SCHEDULER_CORPUS_SYNC_CRON=*/15 * * * *
CORPUS_SYNC_ENABLED=false
PROJECTS_V2_ENABLED=false
PROJECTS_V2_WRITES_ENABLED=false
PR_CREATE_ENABLED=false
PR_CLOSE_ENABLED=false
PR_REOPEN_ENABLED=false
PR_UPDATE_BRANCH_ENABLED=false
PR_MERGE_ENABLED=false
BRANCH_CREATE_ENABLED=false
BRANCH_REBASE_ENABLED=false
BRANCH_DELETE_ENABLED=false
ISSUE_CLOSE_ENABLED=false
CODE_TASK_TRIGGER_ENABLED=false
# POST /api/evidence (programme runners): off unless enabled, and refuses
# everything while the token is empty.
EVIDENCE_WEBHOOK_TOKEN=
EVIDENCE_INGEST_ENABLED=false
QUICK_FIX_TRIGGER_ENABLED=false
SCHEDULER_QUICK_FIX_POLL_CRON=*/5 * * * *
STALE_PR_CHASE_ENABLED=false
SCHEDULER_STALE_PR_CHASE_CRON=57 9 * * *
PROGRESS_CHECK_ENABLED=false
SCHEDULER_PROGRESS_CHECK_CRON=13 9 * * 1-5
STALE_PR_NUDGE_ENABLED=false
PREVIEW_LINK_RELAY_ENABLED=false
SCHEDULER_STALE_PR_NUDGE_CRON=27 9 * * 1-5
# Not read by the server: memory is switched on by `enabled` in memory-policy.yaml.
MEMORY_ENABLED=false
COST_LEDGER_ENABLED=false
WORK_ITEM_CREATE_ENABLED=false
SPEC_SESSIONS_ENABLED=false
SPEC_WRITES_ENABLED=false
SPEC_APPROVAL_ENABLED=false
SPEC_DRAFT_MODEL=
SPEC_CONFORMANCE_ENABLED=false
SPEC_CONFORMANCE_DIFF_MAX_FILES=40
SPEC_CONFORMANCE_DIFF_MAX_CHARS=60000
BUDGET_STRICT_MODE=false
DIGEST_ENABLED=false
SCHEDULER_DIGEST_CRON=3 9 * * *
SCHEDULER_REBASE_POLL_CRON=*/2 * * * *
WORKFLOW_CLASSIFICATION_ENABLED=false

# Server app (apps/server)
AGENT_NAME=Lexi
# Bearer token for POST /process, /reprocess, /retest. Empty refuses every request.
PROCESS_API_TOKEN=
SLACK_TURN_TIMEOUT_MS=900000
SLACK_TURN_ABORT_GRACE_MS=30000
SLACK_THREAD_QUEUE_MAX=5
# Per-person turn limit, checked before any model call. Empty: 12 per 10 minutes. 0: off.
SLACK_USER_TURN_LIMIT=
SLACK_USER_TURN_WINDOW_MS=
# Hosts whose masked links keep their label in replies, besides github.com (comma-separated).
SLACK_LINK_HOSTS=
SLACK_THREAD_HISTORY_LIMIT=30
# App-build tools. Need GitHub credentials and repos.yaml. An empty workflow
# ref dispatches on the repository's default branch.
APP_BUILD_ENABLED=false
APP_BUILD_DEFAULT_REPOSITORY=
APP_BUILD_WORKFLOW_REF=
# Rebuild programme. Also needs `enabled: true` in programme-policy.yaml,
# GitHub credentials and repos.yaml. Dispatch and auto-merge have their own
# switches. PROGRAMME_BRIEF_TOKEN guards the brief routes; empty refuses them.
PROGRAMME_ENABLED=false
PROGRAMME_DISPATCH_ENABLED=false
PROGRAMME_AUTO_MERGE_ENABLED=false
PROGRAMME_PUBLIC_BASE_URL=
PROGRAMME_REVIEW_CHANNEL=
PROGRAMME_BRIEF_TOKEN=
PROGRAMME_FINDINGS_REPO=
PROGRAMME_TICK_MS=300000
