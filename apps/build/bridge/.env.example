# Copy to apps/build/bridge/.env and fill in locally. .env is git-ignored: never commit it,
# never paste credentials into chat. Every value is optional.
#
# The bridge passes its whole environment to the agent processes it starts, so anything set
# here is visible to the agents working in the build workspace. Set only what they need.

# --- Bridge -----------------------------------------------------------------------------
# LEXI_BRIDGE_PORT=7341                 # serves the Table UI and the WebSocket (127.0.0.1 only)
# LEXI_WORKSPACE_ROOT=~/LexiBuilds      # one folder per build lives here
# LEXI_RUNNER=claude                    # default agent CLI: claude | kiro | cursor | codex
# LEXI_PHASE_TIMEOUT_MS=1200000         # per agent run
# LEXI_MAX_STEPS=40                     # Lexi's management-step budget per build
# LEXI_ALLOWED_ORIGINS=                 # extra browser origins allowed to open the socket (comma-separated)

# --- Model access (read by the agent CLIs themselves) --------------------------------------
# Each runner uses its own login by default. To route through an API key or a gateway:
# ANTHROPIC_API_KEY=replace-me          # Claude Code
# ANTHROPIC_BASE_URL=https://llm-gateway.example.com
# OPENAI_API_KEY=replace-me             # Codex
# OPENAI_BASE_URL=https://llm-gateway.example.com/v1
# CURSOR_API_KEY=replace-me             # Cursor Agent
# Pin models per runner (empty = the runner's default):
# LEXI_MODEL_CLAUDE=opus
# LEXI_MODEL_KIRO=claude-opus-5.5
# LEXI_MODEL_CURSOR=
# LEXI_MODEL_CODEX=
# Custom binaries: CLAUDE_BIN, KIRO_BIN, CURSOR_AGENT_BIN, CODEX_BIN

# --- What the crew builds from -----------------------------------------------------------
# LEXI_BUSINESS_SPEC=/path/to/business-spec.md   # default: the sample spec in seed/
# LEXI_SOURCES_DIR=/path/to/docs                 # canonical docs (API specs, standards) copied to docs/
# Design system (pluggable): a markdown file, a folder of docs, or an npm package name.
# LEXI_DESIGN_SYSTEM=@your-org/design-system
# LEXI_DESIGN_SYSTEM_VERSION=^1.0.0               # only for a package; default: any version
# A read-only reference app agents may borrow from (symlinked at references/app):
# LEXI_REFERENCE_APP_DIR=/path/to/existing-app
# LEXI_REFERENCE_APP_NAME=our current web app

# --- Optional MCP sources (HTTPS, or http on loopback) --------------------------------------
# Competitor research. Without it Scout researches from its own knowledge and says so.
# LEXI_MOBBIN_MCP_URL=https://api.mobbin.com/mcp
# Figma designs for Pixel to read. The agent CLI handles the Figma login.
# LEXI_FIGMA_MCP_URL=https://mcp.figma.com/mcp

# --- GitHub (optional) -------------------------------------------------------------------
# Only if you want agents to push a shipped workspace themselves with `gh`/`git`.
# GH_TOKEN=replace-me
